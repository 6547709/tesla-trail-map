# Sample environment file — copy to `.env` and fill in real values.
# `.env` is gitignored; this `.env.example` is safe to commit.
#
#   cp .env.example .env
#   # then edit .env

# ─── Required ─────────────────────────────────────────────────
# Where the TeslaMate PostgreSQL lives.
DATABASE_HOST=192.168.66.200
DATABASE_PORT=54320
DATABASE_USER=teslamate
DATABASE_PASS=replace_me_with_a_real_password
DATABASE_NAME=teslamate

# ─── Optional ─────────────────────────────────────────────────
DATABASE_SSLMODE=disable
TZ=Asia/Shanghai

# Trail Map's exposed HTTP port on the host (compose maps 8080:8080).
# Change the LEFT side if 8080 is taken on your host.
# (Edit ports: in docker-compose.yml accordingly — env var alone won't reroute.)
